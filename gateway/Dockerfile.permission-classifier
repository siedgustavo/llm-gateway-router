# permission-classifier-router: clasificador de permisos de auto-mode 100% local.
# Reemplaza el `pip install` en runtime del docker-compose por una imagen horneada.
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn httpx

COPY permission_classifier.py /app/permission_classifier.py

EXPOSE 4002

CMD ["uvicorn", "permission_classifier:app", "--host", "0.0.0.0", "--port", "4002"]
