# auto-router: proxy FastAPI que expone el modelo virtual "auto" (clasifica y reenvia).
# Reemplaza el `pip install` en runtime del docker-compose por una imagen horneada.
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn httpx

COPY auto_router.py /app/auto_router.py

EXPOSE 4001

CMD ["uvicorn", "auto_router:app", "--host", "0.0.0.0", "--port", "4001"]
